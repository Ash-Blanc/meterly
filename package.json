{
  "name": "oracle-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Cost-aware sidecar agent for TrueForge — estimates, budgets, and gates LLM spend for any agent that connects to it.",
  "type": "module",
  "scripts": {
    "dev": "trueforge --port 8790",
    "mcp:dev": "tsx mcp-server/src/index.ts",
    "api:dev": "tsx api/src/server.ts",
    "dashboard:dev": "npx serve dashboard -l 3000",
    "seed": "tsx scripts/seed-data.ts",
    "demo": "tsx scripts/demo-flow.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@truefoundry/trueforge-sdk": "^0.1.0",
    "express": "^4.21.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
